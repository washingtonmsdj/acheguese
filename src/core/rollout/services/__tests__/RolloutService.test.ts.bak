/**
 * LocationService - Unit Tests
 */

import { describe, it, expect, beforeEach } from 'vitest';
import { LocationService } from '../LocationService';
import { LocationRepositoryMock } from '../../repositories/LocationRepositoryMock';
import { LocationErrorCode } from '../../types';

describe('LocationService', () => {
  let service: LocationService;
  let repository: LocationRepositoryMock;

  beforeEach(() => {
    repository = new LocationRepositoryMock();
    service = new LocationService(repository);
  });

  describe('getLocationById', () => {
    it('should return location by id', async () => {
      const result = await service.getLocationById({ id: 'loc-br' });
      expect(result.location.slug).toBe('br');
      expect(result.location.name).toBe('Brasil');
    });

    it('should throw LOCATION_NOT_FOUND for invalid id', async () => {
      await expect(service.getLocationById({ id: 'invalid' })).rejects.toMatchObject({
        code: LocationErrorCode.LOCATION_NOT_FOUND,
      });
    });
  });

  describe('getLocationByPath', () => {
    it('should return location by path', async () => {
      const result = await service.getLocationByPath({ path: '/br/ba/salvador' });
      expect(result.location.slug).toBe('salvador');
      expect(result.location.name).toBe('Salvador');
    });

    it('should throw INVALID_PATH for path without /', async () => {
      await expect(service.getLocationByPath({ path: 'invalid' })).rejects.toMatchObject({
        code: LocationErrorCode.INVALID_PATH,
      });
    });
  });

  describe('getLocationBySlugWithinParent (slug scoped)', () => {
    it('should return location by slug within parent', async () => {
      const result = await service.getLocationBySlugWithinParent({
        slug: 'pituba',
        parent_id: 'loc-salvador',
      });
      expect(result.location.name).toBe('Pituba');
      expect(result.location.parent_id).toBe('loc-salvador');
    });

    it('should throw PARENT_NOT_FOUND for invalid parent', async () => {
      await expect(
        service.getLocationBySlugWithinParent({ slug: 'pituba', parent_id: 'invalid' })
      ).rejects.toMatchObject({
        code: LocationErrorCode.PARENT_NOT_FOUND,
      });
    });

    it('should throw LOCATION_NOT_FOUND for slug not in parent', async () => {
      await expect(
        service.getLocationBySlugWithinParent({ slug: 'nonexistent', parent_id: 'loc-salvador' })
      ).rejects.toMatchObject({
        code: LocationErrorCode.LOCATION_NOT_FOUND,
      });
    });
  });

  describe('getAncestors', () => {
    it('should return ancestors in order (closest to farthest)', async () => {
      const result = await service.getAncestors({ location_id: 'loc-pituba', include_self: false });
      
      expect(result.ancestors).toHaveLength(3);
      expect(result.ancestors[0].slug).toBe('salvador'); // Closest
      expect(result.ancestors[1].slug).toBe('ba');
      expect(result.ancestors[2].slug).toBe('br'); // Farthest
    });

    it('should include self when requested', async () => {
      const result = await service.getAncestors({ location_id: 'loc-pituba', include_self: true });
      
      expect(result.ancestors).toHaveLength(4);
      expect(result.ancestors[0].slug).toBe('pituba'); // Self first
    });
  });

  describe('getDescendants', () => {
    it('should return descendants with pagination', async () => {
      const result = await service.getDescendants({
        location_id: 'loc-salvador',
        page: 1,
        page_size: 3,
      });
      
      expect(result.descendants.length).toBeLessThanOrEqual(3);
      expect(result.total_count).toBeGreaterThan(0);
    });

    it('should respect max_depth limit', async () => {
      await expect(
        service.getDescendants({ location_id: 'loc-br', max_depth: 20 })
      ).rejects.toMatchObject({
        code: LocationErrorCode.INVALID_HIERARCHY,
      });
    });
  });

  describe('getChildren', () => {
    it('should return direct children only', async () => {
      const result = await service.getChildren({ location_id: 'loc-salvador' });
      
      expect(result.children.length).toBeGreaterThan(0);
      result.children.forEach((child) => {
        expect(child.parent_id).toBe('loc-salvador');
        expect(child.type).toBe('district');
      });
    });

    it('should filter by type', async () => {
      const result = await service.getChildren({
        location_id: 'loc-br',
        type: 'state' as any,
      });
      
      result.children.forEach((child) => {
        expect(child.type).toBe('state');
      });
    });
  });

  describe('validateLocation', () => {
    it('should validate location exists and is active', async () => {
      const result = await service.validateLocation({
        location_id: 'loc-br',
        required_status: 'active' as any,
      });
      
      expect(result.is_valid).toBe(true);
      expect(result.validation_errors).toHaveLength(0);
    });

    it('should return validation errors for invalid location', async () => {
      const result = await service.validateLocation({
        location_id: 'invalid',
      });
      
      expect(result.is_valid).toBe(false);
      expect(result.validation_errors).toContain('Location not found');
    });
  });
});
