{
  "schemaVersion": "edge-function-auth-policy/v1",
  "requireExplicitConfigForAllFunctions": true,
  "noJwtAllowlist": {
    "auth-username-login": {
      "kind": "public-auth-broker",
      "label": "public username login broker",
      "requiredPatterns": [
        "rateLimitMiddleware\\s*\\(",
        "get_email_by_username",
        "signInWithPassword\\s*\\(",
        "returnSessionPayload\\s*\\(",
        "resource:\\s*['\"]auth-username-login['\"]",
        "INVALID_LOGIN_MESSAGE"
      ]
    },
    "track-public-view": {
      "kind": "public-counter-broker",
      "label": "public view counter broker",
      "requiredPatterns": [
        "rateLimitMiddleware\\s*\\(",
        "publicViewEventSchema",
        "VIEW_COUNTER_RPCS",
        "increment_business_views",
        "increment_professional_views",
        "increment_vaga_view_count",
        "resource:\\s*['\"]track-public-view['\"]",
        "Unable to track public view"
      ]
    },
    "register-community-interest": {
      "kind": "public-registration-broker",
      "label": "public authoritative Community Interest registration broker",
      "requiredPatterns": [
        "requireHttpMethod\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "readJsonBody<unknown>\\s*\\(",
        "getRequiredEnv\\s*\\(\\s*[\"']TURNSTILE_SECRET_KEY[\"']\\s*\\)",
        "verifyTurnstileToken\\s*\\(",
        "executeCommunityInterestRegistration\\s*\\(",
        "getSupabaseAdminClient\\s*\\("
      ]
    },
    "create-professional-lead": {
      "kind": "public-registration-broker",
      "label": "public authoritative Professional lead intake broker",
      "requiredPatterns": [
        "requireHttpMethod\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "readJsonBody<unknown>\\s*\\(",
        "getRequiredEnv\\s*\\(\\s*[\"']TURNSTILE_SECRET_KEY[\"']\\s*\\)",
        "verifyTurnstileToken\\s*\\(",
        "executeProfessionalLeadIntake\\s*\\(",
        "getSupabaseAdminClient\\s*\\(",
        "get_active_profile",
        "professional_leads"
      ]
    },
    "auto-dispatch-ride": {
      "kind": "cron-secret",
      "label": "cron ride dispatch worker",
      "requiredPatterns": [
        "requireCronSecret\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "billing-webhook": {
      "kind": "signed-webhook",
      "label": "Stripe billing webhook",
      "requiredPatterns": [
        "stripe-signature",
        "constructEvent\\s*\\(",
        "STRIPE_WEBHOOK_SECRET",
        "register_stripe_webhook_event"
      ]
    },
    "resend-emergency-webhook": {
      "kind": "signed-webhook",
      "label": "Resend emergency delivery webhook",
      "requiredPatterns": [
        "requireHttpMethod\\s*\\(",
        "readTextBody\\s*\\(",
        "webhookVerifier\\.verify\\s*\\(",
        "svix-id",
        "svix-timestamp",
        "svix-signature",
        "RESEND_WEBHOOK_SECRET",
        "apply_emergency_delivery_provider_event"
      ]
    },
    "get-push-config": {
      "kind": "public-read",
      "label": "public VAPID config",
      "requiredPatterns": [
        "VAPID_PUBLIC_KEY",
        "rateLimitMiddleware\\s*\\(",
        "Cache-Control"
      ]
    },
    "media-assets-cleanup": {
      "kind": "cron-secret",
      "label": "canonical media orphan cleanup worker",
      "requiredPatterns": [
        "requireCronSecret\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_SERVICE_ROLE_KEY",
