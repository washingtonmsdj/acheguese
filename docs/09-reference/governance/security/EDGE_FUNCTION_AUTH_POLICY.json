    },
    "sitemap": {
      "kind": "public-read",
      "label": "public sitemap",
      "requiredPatterns": [
        "requireHttpMethod\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_ANON_KEY",
        "application/xml"
      ]
    }
