{
  "schemaVersion": "service-role-boundary-policy/v1",
  "description": "Canonical boundary for Supabase service_role key references and operational test Supabase client creation outside Edge Function auth classification.",
  "trackedPatternIds": [
    "service-role-env-access",
    "service-role-key-literal",
    "browser-supabase-client-factory-import",
    "server-api-supabase-client-factory-import",
    "runtime-supabase-package-import",
    "operational-supabase-env-access",
    "operational-supabase-client-factory",
    "script-supabase-client-factory"
  ],
  "forbiddenPrefixes": [
    {
      "prefix": "src/",
      "label": "browser/runtime application source"
    },
    {
      "prefix": "public/",
      "label": "public static assets"
    },
    {
      "prefix": "api/",
      "label": "serverless API runtime outside the shared admin helper"
    }
  ],
  "allowedPrefixes": [
    {
      "prefix": "supabase/functions/",
      "kind": "edge-function",
      "risk": "Critical",
      "label": "Edge Functions are governed by EDGE_FUNCTION_AUTH_POLICY.json#serviceRoleAllowlist.",
      "authority": "docs/09-reference/governance/security/EDGE_FUNCTION_AUTH_POLICY.json#serviceRoleAllowlist",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal"
      ]
    },
    {
      "prefix": "tools/security/",
      "kind": "security-tooling",
      "risk": "High",
      "label": "Canonical security validators and encrypted local secret helpers may inspect service_role names.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal"
      ]
    },
    {
      "prefix": "docs/09-reference/governance/security/",
      "kind": "security-documentation",
      "risk": "Low",
      "label": "Security governance documents may reference key names as policy text.",
      "authority": "docs/09-reference/governance/security/SECURITY_AUTHORITY.md",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal"
      ]
    },
    {
      "prefix": "tests/security/",
      "kind": "security-test-fixture",
      "risk": "Low",
      "label": "Security tests may contain forbidden examples as fixtures.",
      "authority": "tests/security/security-authority-migrations.test.ts",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal",
        "operational-supabase-env-access",
        "operational-supabase-client-factory"
      ]
    },
    {
      "prefix": "tests/e2e/",
      "kind": "e2e-test-fixture",
      "risk": "Medium",
      "label": "E2E specs may mention service_role names in skips or setup docs, but must use tests/helpers/operational-env.ts for runtime access.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "prefix": "tests/helpers/",
      "kind": "test-helper",
      "risk": "Medium",
      "label": "Test helpers may mention service_role names as operator guidance; runtime access is restricted to tests/helpers/operational-env.ts.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "prefix": "tests/operational/",
      "kind": "operational-test-fixture",
      "risk": "Medium",
      "label": "Operational tests may mention service_role names as setup guidance, but must use tests/helpers/operational-env.ts for runtime access.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "prefix": ".kiro/",
      "kind": "planning-artifact",
      "risk": "Low",
      "label": "Historical planning artifacts may reference service_role as text only.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    }
  ],
  "allowedPaths": [
    {
      "path": "api/_shared/supabaseAdmin.ts",
      "kind": "server-admin-client",
      "risk": "Critical",
      "label": "Single shared Vercel/API helper for service role Supabase clients.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal",
        "server-api-supabase-client-factory-import"
      ]
    },
    {
      "path": "src/integrations/supabase/supabase.ts",
      "kind": "browser-supabase-client",
      "risk": "High",
      "label": "Single browser Supabase client factory using PUBLIC_SUPABASE_CONFIG and cookie-only auth storage.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "browser-supabase-client-factory-import",
        "runtime-supabase-package-import"
      ]
    },
    {
      "path": "src/integrations/supabase/index.ts",
      "kind": "browser-supabase-public-barrel",
      "risk": "High",
      "label": "Single public barrel allowed to re-export Supabase public types without re-exporting createClient.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["runtime-supabase-package-import"]
    },
    {
      "path": "src/integrations/supabase/cookieStorage.ts",
      "kind": "browser-supabase-storage-adapter",
      "risk": "High",
      "label": "Auth storage adapter may import Supabase storage contracts for the canonical browser client.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["runtime-supabase-package-import"]
    },
    {
      "path": "src/shared/config/security.config.ts",
      "kind": "security-audit-history",
      "risk": "Low",
      "label": "Runtime security SSOT contains historical audit text; env access remains forbidden.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tests/helpers/operational-env.ts",
      "kind": "e2e-operational-env-helper",
      "risk": "High",
      "label": "Single E2E/operational test helper allowed to read operator-supplied Supabase env aliases and create operational clients.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal",
        "operational-supabase-env-access",
        "operational-supabase-client-factory"
      ]
    },
    {
      "path": "tools/maintenance/backup-storage.ts",
      "kind": "operator-script",
      "risk": "High",
      "label": "Administrative storage backup script requiring operator-supplied service_role.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tools/release/economic-benchmark-ssot.mjs",
      "kind": "operator-script",
      "risk": "High",
      "label": "Operational benchmark script using the canonical Supabase tooling helper.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tools/seeds/geocode-locations.ts",
      "kind": "operator-script",
      "risk": "High",
      "label": "Administrative geocoding script requiring operator-supplied service_role.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tools/supabase/supabase-client.mjs",
      "kind": "operator-script-helper",
      "risk": "High",
      "label": "Canonical runtime helper for administrative tools that need service_role.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "service-role-env-access",
        "service-role-key-literal",
        "script-supabase-client-factory"
      ]
    },
    {
      "path": "tools/supabase/supabase-client.ts",
      "kind": "operator-script-helper",
      "risk": "High",
      "label": "Typed facade over tools/supabase/supabase-client.mjs; runtime env access stays in the .mjs helper.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tools/maintenance/restore-storage.ts",
      "kind": "operator-script",
      "risk": "High",
      "label": "Administrative storage restore script requiring operator-supplied service_role.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": ["service-role-key-literal"]
    },
    {
      "path": "tools/security/sanitize-secrets.ts",
      "kind": "security-tooling",
      "risk": "High",
      "label": "Secret sanitization helper may reference service_role key names.",
      "authority": "docs/09-reference/governance/security/SUPABASE_SECURITY_MODEL.md#secrets",
      "allowedPatternIds": [
        "service-role-env-access",
