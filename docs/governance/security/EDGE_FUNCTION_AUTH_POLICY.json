{
  "schemaVersion": "edge-function-auth-policy/v1",
  "requireExplicitConfigForAllFunctions": true,
  "noJwtAllowlist": {
    "auth-username-login": {
      "kind": "public-auth-broker",
      "label": "public username login broker",
      "requiredPatterns": [
        "rateLimitMiddleware\\s*\\(",
        "get_email_by_username",
        "signInWithPassword\\s*\\(",
        "returnSessionPayload\\s*\\(",
        "resource:\\s*['\"]auth-username-login['\"]",
        "INVALID_LOGIN_MESSAGE"
      ]
    },
    "track-public-view": {
      "kind": "public-counter-broker",
      "label": "public view counter broker",
      "requiredPatterns": [
        "rateLimitMiddleware\\s*\\(",
        "publicViewEventSchema",
        "VIEW_COUNTER_RPCS",
        "increment_business_views",
        "increment_professional_views",
        "increment_vaga_view_count",
        "resource:\\s*['\"]track-public-view['\"]",
        "Unable to track public view"
      ]
    },
    "auto-dispatch-ride": {
      "kind": "cron-secret",
      "label": "cron ride dispatch worker",
      "requiredPatterns": [
        "requireCronSecret\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_SERVICE_ROLE_KEY"
      ]
    },
    "billing-webhook": {
      "kind": "signed-webhook",
      "label": "Stripe billing webhook",
      "requiredPatterns": [
        "stripe-signature",
        "constructEvent\\s*\\(",
        "STRIPE_WEBHOOK_SECRET",
        "register_stripe_webhook_event"
      ]
    },
    "get-push-config": {
      "kind": "public-read",
      "label": "public VAPID config",
      "requiredPatterns": [
        "VAPID_PUBLIC_KEY",
        "rateLimitMiddleware\\s*\\(",
        "Cache-Control"
      ]
    },
    "nominatim-proxy": {
      "kind": "public-proxy",
      "label": "public geocoding proxy",
      "requiredPatterns": [
        "rateLimitMiddleware\\s*\\(",
        "NOMINATIM_BASE_URL",
        "sanitizeString",
        "withCache\\s*\\("
      ]
    },
    "process-timeouts": {
      "kind": "cron-secret",
      "label": "cron timeout processor",
      "requiredPatterns": [
        "requireCronSecret\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_SERVICE_ROLE_KEY",
        "process_dispatch_timeouts"
      ]
    },
    "sitemap": {
      "kind": "public-read",
      "label": "public sitemap",
      "requiredPatterns": [
        "requireHttpMethod\\s*\\(",
        "rateLimitMiddleware\\s*\\(",
        "SUPABASE_ANON_KEY",
        "application/xml"
      ]
    }
  },
  "serviceRoleAllowlist": {
