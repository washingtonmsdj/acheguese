# Environment template for local development and CI.
# Do not commit real secrets. Copy to .env.local or configure values in the
# deploy provider and Supabase secrets.

# Public Supabase config used by the browser.
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# Supabase Edge Function runtime.
# SUPABASE_ANON_KEY can use the same public publishable/anon key value.
# SUPABASE_SERVICE_ROLE_KEY must be stored only in a protected secret manager.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_publishable_or_anon_key"
SUPABASE_SERVICE_ROLE_KEY=""

# Public app identity and canonical origin.
VITE_SITE_NAME="Achegue-se"
VITE_SITE_TAGLINE="Super App de Bairro"
VITE_PUBLIC_SITE_URL="https://your-public-domain.example"
VITE_TWITTER_SITE="@acheguese"

# Sentry / observability.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"
VITE_SENTRY_RELEASE=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="acheguese"
SENTRY_PROJECT="acheguese-web"

# Debug flags.
VITE_DEBUG_SENTRY="false"
VITE_DEBUG_WEB_VITALS="false"
VITE_DEBUG_PERFORMANCE="false"
VITE_DEBUG_BOOT="false"
VITE_DEBUG_GEO="false"
VITE_DEBUG_SESSION="false"
VITE_SECURITY_DEBUG="false"

# Feature flags.
VITE_AUTH_GOOGLE_ENABLED="false"
VITE_FEATURE_COMMUNITY_ALERTS="false"
VITE_FEATURE_COMMUNITY_ISSUES="false"
VITE_FEATURE_COMMUNITY_LEADERBOARD="false"
VITE_FEATURE_MAPS_V4="true"
VITE_ENABLE_LOCATION_BOUNDARIES="false"

# Public legal/contact configuration.
VITE_CONTACT_EMAIL=""
VITE_DPO_EMAIL=""
VITE_LEGAL_FORUM=""

# Edge Function security.
BASE_URL="http://localhost:8080"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8099,http://127.0.0.1:8099"
ALLOWED_REDIRECT_DOMAINS="localhost"
DENO_ENV="development"
CRON_SECRET=""
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
CACHE_DEBUG="false"

# Frontend redirect allowlists.
VITE_ALLOWED_QR_REDIRECT_ORIGINS="http://localhost:8080,http://localhost:5173"
VITE_ALLOWED_BILLING_REDIRECT_ORIGINS="https://checkout.stripe.com,https://billing.stripe.com"

# Billing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email.
# Operational only; never expose this key to Edge Functions or browser builds.
RESEND_MANAGEMENT_API_KEY=""
RESEND_API_KEY=""
FROM_EMAIL=""
EMAIL_FROM_DOMAIN=""
EMAIL_FROM_NAME="Achegue-se"

# Push notifications.
VAPID_PUBLIC_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT=""

# AI and image generation.
VITE_FEATURE_AI_VIRTUAL_TRYON=false
LOVABLE_API_KEY=""
REPLICATE_API_TOKEN=""
TRYON_REPLICATE_MODEL_VERSION=""
TRYON_REPLICATE_HUMAN_IMAGE_URL=""
TRYON_REPLICATE_HUMAN_IMAGE_MALE_URL=""
TRYON_REPLICATE_HUMAN_IMAGE_FEMALE_URL=""
TRYON_REPLICATE_HUMAN_IMAGE_NEUTRAL_URL=""

# External services.
VITE_GOOGLE_MAPS_API_KEY=""
VITE_ADSENSE_CLIENT_ID=""
IBGE_DISTRICTS_URL="https://servicodados.ibge.gov.br/api/v1/localidades/distritos?view=nivelado"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT=""
NOMINATIM_ACCEPT_LANGUAGE="pt-BR,pt;q=0.9"
NOMINATIM_DEFAULT_COUNTRY="br"
NOMINATIM_DEFAULT_COUNTRY_CODES="br"
NOMINATIM_DEFAULT_COUNTRY_NAME="Brasil"
NOMINATIM_DEFAULT_FORMAT="json"
NOMINATIM_DEFAULT_ADDRESSDETAILS="1"
NOMINATIM_DEFAULT_LIMIT="3"
NOMINATIM_REQUEST_DELAY_MS="1000"

# Database/admin scripts.
SUPABASE_DB_URL=""
DATABASE_URL=""
SUPABASE_DB_PASSWORD=""
SUPABASE_POOLER_HOST=""
SUPABASE_POOLER_PORT="6543"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER=""

# Optional distributed security store for API routes outside Supabase Edge.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# E2E test credentials. Use strong, unique passwords outside templates.
E2E_USER_EMAIL="e2e-user@test.local"
E2E_USER_PASSWORD=""
E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD=""
# Remote operational tests are disabled unless the operator declares a
# non-production target whose project ref matches VITE_SUPABASE_URL.
OPERATIONAL_TEST_TARGET=""
OPERATIONAL_TEST_PROJECT_REF=""
OPERATIONAL_TEST_CONFIRM=""
TEST_DRIVER_EMAIL="test-driver@test.local"
TEST_DRIVER_PASSWORD=""
E2E_EDUCATION_OWNER_EMAIL=""
E2E_EDUCATION_OWNER_PASSWORD=""
E2E_RECOVERY_EMAIL=""
PLAYWRIGHT_BASE_URL="http://localhost:8080"

# Launch territory.
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
