# Supabase Configuration
# Novo formato de chaves (migração Abr/2026):
# - PUBLISHABLE KEY: sb_publishable_... (substitui anon key JWT)
# - SECRET KEY: sb_secret_... (substitui service_role JWT)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# Sentry Configuration (Error Tracking & Performance Monitoring)
VITE_SENTRY_DSN=""
# Build-time only (não exposto no frontend)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="ordax"
SENTRY_PROJECT="ordax-saas"

# Debug flags
VITE_DEBUG_SENTRY="false"
VITE_DEBUG_WEB_VITALS="false"
VITE_DEBUG_PERFORMANCE="false"

VITE_AUTH_GOOGLE_ENABLED="false"

# Server-side Configuration (NUNCA expor no frontend)
# Carregue a service role no shell atual via:
#   .\scripts\security\Import-LocalSupabaseSecrets.ps1
# O segredo administrativo fica criptografado em %APPDATA%\Ordax\Secrets\...

# Database URL (para scripts que precisam de acesso direto ao PostgreSQL)
# Obtenha em: Supabase Dashboard > Settings > Database > Connection string (Session mode)
SUPABASE_DB_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Community Alerts Feature Flag
VITE_FEATURE_COMMUNITY_ALERTS="false"

# Maps V4 Feature Flag
VITE_FEATURE_MAPS_V4="true"

# Google Maps API Key (configure se necessario)
# VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# E2E Test Credentials (NUNCA commitar valores reais - use .env.local)
E2E_USER_EMAIL="e2e-user@test.local"
E2E_USER_PASSWORD="your_secure_password_here"
E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD="your_secure_password_here"

# Base URL for E2E tests
BASE_URL="http://localhost:8080"

# CORS Configuration (para edge functions)
# Separe múltiplos domínios com vírgula
ALLOWED_ORIGINS="http://localhost:8080,https://yourdomain.com"

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
