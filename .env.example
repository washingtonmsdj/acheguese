# Supabase Configuration Template
# Copie este arquivo para .env e preencha com os valores corretos

# Supabase Project Configuration
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key"

# IMPORTANTE: Esta variável deve ser configurada como SECRET
# Para desenvolvimento local: crie .env.local com esta variável
# Para produção: configure como variável de ambiente no seu provedor
# VITE_SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Sentry Configuration (Error Monitoring)
# Obtenha seu DSN em: https://sentry.io/settings/projects/
# Deixe vazio para desabilitar o Sentry em desenvolvimento
VITE_SENTRY_DSN=""

# Community Alerts Feature Flag
# Defina como "true" para ativar o sistema de alertas comunitários
VITE_FEATURE_COMMUNITY_ALERTS="false"

# Maps V4 Feature Flag
# Defina como "true" para ativar a nova arquitetura de mapas (MapaPageV4)
# "false" mantém a página legada (MapaPage)
# Subgate de ambiente real ainda aberto: tiles GPU, tap real, gestos Safari/iOS, cluster zoom
VITE_FEATURE_MAPS_V4="true"

# Google Maps API Key
# Obtenha sua chave em: https://console.cloud.google.com/apis/credentials
# Restrinja por domínio e APIs (Maps Embed API, Geocoding API)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# E2E Test Credentials (opcional - apenas para testes automatizados)
# Copie estas variáveis para .env.test e configure com credenciais reais
# Veja E2E_SETUP.md para instruções completas de configuração
E2E_USER_EMAIL="e2e-user@test.local"
E2E_USER_PASSWORD="[YOUR_TEST_PASSWORD]"
E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD="[YOUR_ADMIN_PASSWORD]"

# Base URL for E2E tests
BASE_URL="http://localhost:8080"

# ============================================================================
# STRIPE CONFIGURATION (Gastronomy Billing)
# ============================================================================
# 
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys
# 
# IMPORTANTE: 
# - Use chaves de TESTE durante desenvolvimento
# - Use chaves de PRODUÇÃO apenas em produção
# - NUNCA commite as chaves reais no repositório
#
# Chaves de API
STRIPE_SECRET_KEY="sk_test_your_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Price IDs dos produtos (obtenha após criar produtos no Stripe Dashboard)
# Crie os produtos em: https://dashboard.stripe.com/products
STRIPE_PRICE_ID_PRO="price_your_pro_plan_id"
STRIPE_PRICE_ID_DELIVERY="price_your_delivery_plan_id"

# Webhook Secret (obtenha após criar webhook no Stripe Dashboard)
# Configure webhook em: https://dashboard.stripe.com/webhooks
# Endpoint: https://your-project.supabase.co/functions/v1/stripe-webhook
# Eventos: customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
#
# ============================================================================

# ============================================================================
# SUPABASE MIGRATIONS - MÉTODO CORRETO (SSOT)
# ============================================================================
# 
# MÉTODO CORRETO para aplicar migrações no banco remoto:
#
# npx supabase db query --linked -f supabase/migrations/<nome_da_migracao>.sql
#
# Exemplo:
# npx supabase db query --linked -f supabase/migrations/20260405000003_complete_community_issues_schema.sql
#
# IMPORTANTE - SSOT (Single Source of Truth):
# 1. Sempre verifique a estrutura existente no banco ANTES de criar migrações
# 2. Use information_schema para descobrir nomes de colunas reais:
#    npx supabase db query --linked "SELECT column_name FROM information_schema.columns WHERE table_name = 'sua_tabela';"
# 3. Siga os tipos definidos no código TypeScript (domain/types.ts)
# 4. Use IF NOT EXISTS e DO $$ blocks para migrações idempotentes
# 5. Nunca assuma nomes de colunas - sempre verifique primeiro
#
# VERIFICAÇÃO PÓS-MIGRAÇÃO:
# npx supabase db query --linked "SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'sua_tabela' ORDER BY ordinal_position;"
#
# ERROS COMUNS EVITADOS:
# ❌ Assumir que coluna se chama "reporter_profile_id" quando é "profile_id"
# ❌ Assumir que existe coluna "role" quando é "is_super_admin" em outro schema
# ❌ Usar "npx supabase db push" quando há migrações dessincronizadas
# ✅ Sempre verificar estrutura real antes de criar foreign keys
# ✅ Sempre verificar constraints existentes antes de adicionar novos
# ============================================================================
