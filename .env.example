# Supabase Configuration
# Novo formato de chaves (migração Abr/2026):
# - PUBLISHABLE KEY: sb_publishable_... (substitui anon key JWT)
# - SECRET KEY: sb_secret_... (substitui service_role JWT)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# Public branding/domain SSOT
VITE_SITE_NAME="Achegue-se"
VITE_SITE_TAGLINE="Super App de Bairro"
VITE_PUBLIC_SITE_URL="https://acheguese.com.br"
VITE_TWITTER_SITE="@acheguese"

# Sentry Configuration (Error Tracking & Performance Monitoring)
VITE_SENTRY_DSN=""
# Build-time only (não exposto no frontend)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="acheguese"
SENTRY_PROJECT="acheguese-web"

# Debug flags
VITE_DEBUG_SENTRY="false"
VITE_DEBUG_WEB_VITALS="false"
VITE_DEBUG_PERFORMANCE="false"

VITE_AUTH_GOOGLE_ENABLED="false"

# Server-side Configuration (NUNCA expor no frontend)
# Carregue a service role no shell atual via:
#   .\scripts\security\Import-LocalSupabaseSecrets.ps1
# O segredo administrativo fica criptografado em %APPDATA%\Achegue-se\Secrets\...

# Database URL (para scripts que precisam de acesso direto ao PostgreSQL)
# Obtenha em: Supabase Dashboard > Settings > Database > Connection string (Session mode)
SUPABASE_DB_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Community Alerts Feature Flag
VITE_FEATURE_COMMUNITY_ALERTS="false"

# Maps V4 Feature Flag
VITE_FEATURE_MAPS_V4="true"

# Google Maps API Key (configure se necessario)
# VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Google AdSense Configuration
# Obtenha seu Publisher ID em: https://www.google.com/adsense
# Formato: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"

# E2E Test Credentials (NUNCA commitar valores reais - use .env.local)
E2E_USER_EMAIL="e2e-user@test.local"
E2E_USER_PASSWORD="your_secure_password_here"
E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD="your_secure_password_here"

# Base URL for E2E tests
BASE_URL="http://localhost:8080"

# CORS Configuration (para edge functions)
# Separe múltiplos domínios com vírgula
ALLOWED_ORIGINS="http://localhost:8080,https://yourdomain.com"

# Redirect allowlists (frontend)
# QR codes should normally redirect only inside the public app; add external origins only when business rules require it.
VITE_ALLOWED_QR_REDIRECT_ORIGINS="https://yourdomain.com"
# Billing checkout/portal origins are validated client-side and server-side.
VITE_ALLOWED_BILLING_REDIRECT_ORIGINS="https://checkout.stripe.com,https://billing.stripe.com"

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# Distributed security store (recommended for production/serverless)
# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Territorio comunitario principal da home
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
