-- ═══════════════════════════════════════════════════════════════════════════════
-- VAGAS DOMAIN AAA — Single Source of Truth (SSOT)
-- ═══════════════════════════════════════════════════════════════════════════════
-- 
-- Descrição: Domínio completo e profissional de vagas de emprego
--            Suporte a: listagem territorial, detalhe canônico, candidatura tipada
-- 
-- Versão: 3.0.0 - Nível AAA
-- Data: 2026-04-16
-- 
-- ═══════════════════════════════════════════════════════════════════════════════

-- ───────────────────────────────────────────────────────────────────────────────
-- 1. ENUMS COMPLETOS (SSOT)
-- ───────────────────────────────────────────────────────────────────────────────

-- Status da vaga com ciclo de vida completo
CREATE TYPE vaga_status AS ENUM (
  'draft',           -- Rascunho (criado, não publicado)
  'pending_review',  -- Aguardando moderação
  'published',       -- Publicada e visível
  'paused',          -- Pausada temporariamente
  'closed',          -- Encerrada (preenchida ou cancelada)
  'expired',         -- Expirada automaticamente
  'rejected',        -- Rejeitada na moderação
  'removed'          -- Removida por violação
);

-- Tipo de contrato
CREATE TYPE vaga_contrato AS ENUM (
  'CLT',
  'PJ',
  'estagio',
  'temporario',
  'freelancer',
  'aprendiz'
);

-- Modalidade de trabalho
CREATE TYPE vaga_modalidade AS ENUM (
  'presencial',
  'hibrido',
  'remoto'
);

-- Nível de experiência
CREATE TYPE vaga_nivel AS ENUM (
  'junior',
  'pleno',
  'senior',
  'especialista',
  'gerente',
  'diretor',
  'estagio',
  'auxiliar'
);

-- Urgência da vaga
CREATE TYPE vaga_urgencia AS ENUM (
  'normal',
  'urgente',
  'extrema'
);

-- Canal de candidatura (tipado - nunca campo solto)
CREATE TYPE vaga_application_channel AS ENUM (
  'internal',      -- Candidatura via plataforma
  'whatsapp',      -- Contato via WhatsApp
  'email',         -- Envio de currículo por e-mail
  'external_url',  -- Redirecionamento para site externo
  'phone'          -- Contato telefônico
);

-- Modo de exibição de salário
CREATE TYPE vaga_salary_mode AS ENUM (
  'fixed',         -- Valor fixo
  'range',         -- Faixa (min-max)
  'a_combinar'     -- A combinar
);

-- Tipo de destaque/patrocínio
CREATE TYPE vaga_highlight_type AS ENUM (
  'none',          -- Sem destaque
  'premium',       -- Premium (topo da lista)
  'sponsored',     -- Patrocinada
  'featured'       -- Destaque especial
);

-- ───────────────────────────────────────────────────────────────────────────────
-- 2. TABELA PRINCIPAL: vagas
-- ───────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS vagas (
  -- Identificação
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  slug TEXT NOT NULL UNIQUE, -- URL canônica: /vagas/:uf/:cidade/:slug
  
  -- Dados da vaga
  titulo TEXT NOT NULL,
  descricao TEXT NOT NULL,
  resumo TEXT, -- Breve resumo para cards (150-200 chars)
  
  -- Empresa (relacionamento flexível)
  empresa_nome TEXT NOT NULL, -- Nome da empresa (denormalizado para performance)
  empresa_logo_url TEXT, -- URL do logo
  empresa_id UUID REFERENCES businesses(id) ON DELETE SET NULL, -- Link opcional ao perfil
  owner_profile_id UUID REFERENCES profiles(id) ON DELETE CASCADE, -- Dono da vaga (obrigatório)
  
  -- Localização territorial (SSOT)
  location_id UUID NOT NULL REFERENCES locations(id) ON DELETE CASCADE,
  bairro_id UUID REFERENCES locations(id) ON DELETE SET NULL, -- Bairro específico (opcional)
  
  -- Classificação
  categoria TEXT NOT NULL, -- Categoria principal (tecnologia, saude, etc)
  subcategoria TEXT, -- Especialização
  contrato vaga_contrato NOT NULL,
  modalidade vaga_modalidade NOT NULL,
  nivel vaga_nivel NOT NULL,
  
  -- Tags para busca e filtros
  tags TEXT[] NOT NULL DEFAULT '{}',
  
  -- Remuneração (flexível e estruturada)
  salary_mode vaga_salary_mode DEFAULT 'a_combinar',
  salario_min INTEGER, -- Em centavos
  salario_max INTEGER, -- Em centavos
  salario_texto TEXT, -- Texto alternativo (ex: "R$ 2.500 + comissão")
  benefícios TEXT[] NOT NULL DEFAULT '{}',
  
  -- Detalhes da vaga
  requisitos TEXT[] NOT NULL DEFAULT '{}', -- Requisitos obrigatórios
  diferenciais TEXT[] NOT NULL DEFAULT '{}', -- Diferenciais desejáveis
  responsabilidades TEXT[] NOT NULL DEFAULT '{}', -- Atribuições do cargo
  jornada_descricao TEXT, -- Descrição da jornada/escala
  
  -- Candidatura (canal tipado - SSOT)
  application_channel vaga_application_channel NOT NULL DEFAULT 'internal',
  application_url TEXT, -- URL para candidatura (quando external_url)
  application_whatsapp TEXT, -- Número WhatsApp formatado
  application_email TEXT, -- E-mail para currículo
  application_phone TEXT, -- Telefone para contato
  application_instructions TEXT, -- Instruções adicionais
  
  -- Controle e status
  status vaga_status NOT NULL DEFAULT 'draft',
  urgencia vaga_urgencia NOT NULL DEFAULT 'normal',
  highlight_type vaga_highlight_type DEFAULT 'none',
  vagas_quantidade INTEGER DEFAULT 1, -- Quantidade de vagas disponíveis
  
  -- Datas do ciclo de vida
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  published_at TIMESTAMPTZ, -- Data de publicação (quando sair do draft)
  expires_at TIMESTAMPTZ, -- Data de expiração automática
  closed_at TIMESTAMPTZ, -- Data de encerramento
  
  -- SEO e Metadados
  meta_title TEXT, -- Título para SEO
  meta_description TEXT, -- Descrição para SEO
  og_image_url TEXT, -- Imagem para Open Graph
  
  -- Moderação
  moderated_by UUID REFERENCES profiles(id) ON DELETE SET NULL,
  moderated_at TIMESTAMPTZ,
  moderation_notes TEXT,
  
  -- Analytics (contadores)
  view_count INTEGER DEFAULT 0,
  application_count INTEGER DEFAULT 0,
  share_count INTEGER DEFAULT 0,
  
  -- Constraints
  CONSTRAINT valid_salary_range CHECK (
    salario_min IS NULL OR salario_max IS NULL OR salario_min <= salario_max
  ),
  CONSTRAINT valid_application_url CHECK (
    application_channel != 'external_url' OR application_url IS NOT NULL
  ),
  CONSTRAINT valid_application_contact CHECK (
    NOT (application_channel = 'whatsapp' AND application_whatsapp IS NULL) AND
    NOT (application_channel = 'email' AND application_email IS NULL) AND
    NOT (application_channel = 'phone' AND application_phone IS NULL)
  )
);

-- ───────────────────────────────────────────────────────────────────────────────
-- 3. ÍNDICES OTIMIZADOS
-- ───────────────────────────────────────────────────────────────────────────────

-- Índice principal de localização + status (listagem territorial)
CREATE INDEX idx_vagas_location_status 
  ON vagas(location_id, status, published_at DESC)
  WHERE status = 'published';

-- Índice de bairro para filtros
CREATE INDEX idx_vagas_bairro 
  ON vagas(bairro_id)
  WHERE bairro_id IS NOT NULL;

-- Índice de slug para busca por URL canônica
CREATE INDEX idx_vagas_slug 
  ON vagas(slug);

-- Índice de status para admin/filtros
CREATE INDEX idx_vagas_status 
  ON vagas(status, updated_at DESC);

-- Índice de urgência (vagas urgentes em destaque)
CREATE INDEX idx_vagas_urgencia 
  ON vagas(location_id, urgencia, created_at DESC)
  WHERE status = 'published' AND urgencia IN ('urgente', 'extrema');

-- Índice de destaque/patrocínio
CREATE INDEX idx_vagas_highlight 
  ON vagas(location_id, highlight_type, created_at DESC)
  WHERE status = 'published' AND highlight_type != 'none';

-- Índice de categoria
CREATE INDEX idx_vagas_categoria 
  ON vagas(categoria, location_id)
  WHERE status = 'published';

-- Índice de contrato
CREATE INDEX idx_vagas_contrato 
  ON vagas(contrato, location_id)
  WHERE status = 'published';

-- Índice de modalidade
CREATE INDEX idx_vagas_modalidade 
  ON vagas(modalidade, location_id)
  WHERE status = 'published';

-- Índice de nível
CREATE INDEX idx_vagas_nivel 
  ON vagas(nivel, location_id)
  WHERE status = 'published';

-- Índice de data de criação (ordenação padrão)
CREATE INDEX idx_vagas_created_at 
  ON vagas(created_at DESC);

-- Índice de expiração (para jobs de limpeza)
CREATE INDEX idx_vagas_expires_at 
  ON vagas(expires_at)
  WHERE status = 'published' AND expires_at IS NOT NULL;

-- Índice de tags para busca
CREATE INDEX idx_vagas_tags 
  ON vagas USING GIN(tags)
  WHERE status = 'published';

-- Índice de busca full-text em português
CREATE INDEX idx_vagas_search 
  ON vagas USING GIN(
    to_tsvector('portuguese', 
      coalesce(titulo, '') || ' ' || 
      coalesce(empresa_nome, '') || ' ' || 
      coalesce(descricao, '') || ' ' ||
      coalesce(resumo, '') || ' ' ||
      coalesce(array_to_string(tags, ' '), '')
    )
  )
  WHERE status = 'published';

-- Índice de empresa para "outras vagas da empresa"
CREATE INDEX idx_vagas_empresa 
  ON vagas(empresa_id, status, created_at DESC)
  WHERE empresa_id IS NOT NULL AND status = 'published';

-- Índice de owner para gestão
CREATE INDEX idx_vagas_owner 
  ON vagas(owner_profile_id, status, created_at DESC);

-- ───────────────────────────────────────────────────────────────────────────────
-- 4. ROW LEVEL SECURITY (RLS)
-- ───────────────────────────────────────────────────────────────────────────────

ALTER TABLE vagas ENABLE ROW LEVEL SECURITY;

-- Política: Leitura pública de vagas publicadas e não expiradas
CREATE POLICY "vagas_public_read"
  ON vagas
  FOR SELECT
  USING (
    status = 'published' AND 
    (expires_at IS NULL OR expires_at > now())
  );

-- Política: Dono pode ver suas próprias vagas em qualquer status
CREATE POLICY "vagas_owner_read"
  ON vagas
  FOR SELECT
  TO authenticated
  USING (
    owner_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    )
  );

-- Política: Dono pode criar vagas
CREATE POLICY "vagas_owner_create"
  ON vagas
  FOR INSERT
  TO authenticated
  WITH CHECK (
    owner_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    )
  );

-- Política: Dono pode atualizar suas vagas (exceto se removida por admin)
CREATE POLICY "vagas_owner_update"
  ON vagas
  FOR UPDATE
  TO authenticated
  USING (
    owner_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    ) AND
    status != 'removed'
  )
  WITH CHECK (
    owner_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    )
  );

-- Política: Dono pode deletar suas vagas em rascunho
CREATE POLICY "vagas_owner_delete"
  ON vagas
  FOR DELETE
  TO authenticated
  USING (
    owner_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    ) AND
    status IN ('draft', 'pending_review')
  );

-- Política: Admin pode tudo
CREATE POLICY "vagas_admin_all"
  ON vagas
  FOR ALL
  TO service_role
  USING (true)
  WITH CHECK (true);

-- ───────────────────────────────────────────────────────────────────────────────
-- 5. TRIGGERS
-- ───────────────────────────────────────────────────────────────────────────────

-- Trigger de updated_at
CREATE TRIGGER set_vagas_updated_at
  BEFORE UPDATE ON vagas
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- Trigger: Atualizar view_count (protegido contra decremento)
CREATE OR REPLACE FUNCTION increment_vaga_view_count()
RETURNS TRIGGER AS $$
BEGIN
  NEW.view_count = GREATEST(OLD.view_count + 1, OLD.view_count);
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger: Definir published_at ao publicar
CREATE OR REPLACE FUNCTION set_vaga_published_at()
RETURNS TRIGGER AS $$
BEGIN
  IF NEW.status = 'published' AND OLD.status != 'published' THEN
    NEW.published_at = now();
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER vaga_set_published_at
  BEFORE UPDATE ON vagas
  FOR EACH ROW
  EXECUTE FUNCTION set_vaga_published_at();

-- Trigger: Definir closed_at ao encerrar
CREATE OR REPLACE FUNCTION set_vaga_closed_at()
RETURNS TRIGGER AS $$
BEGIN
  IF NEW.status = 'closed' AND OLD.status != 'closed' THEN
    NEW.closed_at = now();
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER vaga_set_closed_at
  BEFORE UPDATE ON vagas
  FOR EACH ROW
  EXECUTE FUNCTION set_vaga_closed_at();

-- ───────────────────────────────────────────────────────────────────────────────
-- 6. FUNÇÕES DE BUSCA
-- ───────────────────────────────────────────────────────────────────────────────

-- Busca full-text de vagas
CREATE OR REPLACE FUNCTION search_vagas(
  p_location_id UUID,
  p_query TEXT,
  p_limit INTEGER DEFAULT 20
)
RETURNS TABLE (vaga_id UUID, rank real) AS $$
BEGIN
  RETURN QUERY
  SELECT 
    v.id,
    ts_rank(
      to_tsvector('portuguese', 
        coalesce(v.titulo, '') || ' ' || 
        coalesce(v.empresa_nome, '') || ' ' || 
        coalesce(v.descricao, '')
      ),
      plainto_tsquery('portuguese', p_query)
    ) AS rank
  FROM vagas v
  WHERE 
    v.location_id = p_location_id
    AND v.status = 'published'
    AND (v.expires_at IS NULL OR v.expires_at > now())
    AND (
      p_query IS NULL OR 
      to_tsvector('portuguese', 
        coalesce(v.titulo, '') || ' ' || 
        coalesce(v.empresa_nome, '') || ' ' || 
        coalesce(v.descricao, '')
      ) @@ plainto_tsquery('portuguese', p_query)
    )
  ORDER BY 
    v.highlight_type != 'none' DESC, -- Premium primeiro
    rank DESC,
    v.published_at DESC
  LIMIT p_limit;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- ───────────────────────────────────────────────────────────────────────────────
-- 7. TABELA DE CANDIDATURAS (quando candidatura interna estiver ativa)
-- ───────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS candidaturas (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  vaga_id UUID NOT NULL REFERENCES vagas(id) ON DELETE CASCADE,
  candidato_profile_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,
  
  -- Status da candidatura
  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'viewed', 'shortlisted', 'rejected', 'hired')),
  
  -- Mensagem do candidato
  mensagem TEXT,
  
  -- Currículo anexado
  curriculo_url TEXT,
  
  -- Respostas do empregador
  resposta_empresa TEXT,
  responded_by UUID REFERENCES profiles(id) ON DELETE SET NULL,
  responded_at TIMESTAMPTZ,
  
  -- Metadados
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  
  -- Constraints
  CONSTRAINT unique_candidatura UNIQUE (vaga_id, candidato_profile_id)
);

-- Índices de candidaturas
CREATE INDEX idx_candidaturas_vaga ON candidaturas(vaga_id, status);
CREATE INDEX idx_candidaturas_candidato ON candidaturas(candidato_profile_id, created_at DESC);

-- RLS para candidaturas
ALTER TABLE candidaturas ENABLE ROW LEVEL SECURITY;

CREATE POLICY "candidaturas_vaga_owner_read"
  ON candidaturas
  FOR SELECT
  TO authenticated
  USING (
    vaga_id IN (
      SELECT id FROM vagas WHERE owner_profile_id IN (
        SELECT id FROM profiles WHERE user_id = auth.uid()
      )
    )
  );

CREATE POLICY "candidaturas_candidato_read"
  ON candidaturas
  FOR SELECT
  TO authenticated
  USING (
    candidato_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "candidaturas_candidato_create"
  ON candidaturas
  FOR INSERT
  TO authenticated
  WITH CHECK (
    candidato_profile_id IN (
      SELECT id FROM profiles WHERE user_id = auth.uid()
    )
  );

-- Trigger de updated_at para candidaturas
CREATE TRIGGER set_candidaturas_updated_at
  BEFORE UPDATE ON candidaturas
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();

-- ───────────────────────────────────────────────────────────────────────────────
-- 8. COMENTÁRIOS DOCUMENTANDO SSOT
-- ───────────────────────────────────────────────────────────────────────────────

COMMENT ON TABLE vagas IS 'SSOT: Vagas de emprego - Domínio completo com status, slugs, candidatura tipada e SEO';
COMMENT ON COLUMN vagas.slug IS 'URL canônica única para SEO: /vagas/:uf/:cidade/:slug';
COMMENT ON COLUMN vagas.empresa_id IS 'Link opcional ao perfil da empresa (businesses)';
COMMENT ON COLUMN vagas.owner_profile_id IS 'Dono da vaga (obrigatório) - quem pode gerenciar';
COMMENT ON COLUMN vagas.location_id IS 'Referência territorial SSOT (cidade)';
COMMENT ON COLUMN vagas.bairro_id IS 'Bairro específico para filtros (opcional)';
COMMENT ON COLUMN vagas.salary_mode IS 'Modo de exibição: fixed, range, a_combinar';
COMMENT ON COLUMN vagas.application_channel IS 'Canal de candidatura tipado: internal, whatsapp, email, external_url, phone';
COMMENT ON COLUMN vagas.highlight_type IS 'Tipo de destaque: none, premium, sponsored, featured';
COMMENT ON COLUMN vagas.published_at IS 'Data de publicação real (quando saiu do draft)';
COMMENT ON COLUMN vagas.view_count IS 'Contador de visualizações (nunca decrementa)';

COMMENT ON TABLE candidaturas IS 'Candidaturas internas às vagas (preparado para futuro)';

-- ═══════════════════════════════════════════════════════════════════════════════
-- FIM DA MIGRATION
