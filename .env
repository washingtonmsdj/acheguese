# ⚠️ ESTE ARQUIVO É UM TEMPLATE PÚBLICO
# Valores aqui são seguros para commitar (apenas placeholders)
# Para credenciais reais, use .env.local (não commitado — ver .gitignore)

# Supabase Configuration (Chaves Públicas - Seguro para Frontend)
# Obtenha em: Supabase Dashboard > Settings > API
VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key_here"

# ⚠️ NOTA DE SEGURANÇA:
# A PUBLISHABLE_KEY (anon key) é protegida por RLS (Row Level Security).
# Mesmo assim, NÃO commite valores reais — use .env.local para desenvolvimento
# e variáveis de ambiente do Vercel/Supabase para produção.

# Server-side Configuration (NUNCA expor no frontend)
# Carregue a service role no shell atual via:
#   .\scripts\security\Import-LocalSupabaseSecrets.ps1
# O segredo administrativo fica criptografado em %APPDATA%\Ordax\Secrets\...

# Database URL (para scripts que precisam de acesso direto ao PostgreSQL)
# Obtenha em: Supabase Dashboard > Settings > Database > Connection string (Session mode)
SUPABASE_DB_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# Community Alerts Feature Flag
VITE_FEATURE_COMMUNITY_ALERTS="false"

# Maps V4 Feature Flag
VITE_FEATURE_MAPS_V4="true"

# Google Maps API Key (configure se necessario)
# VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# E2E Test Credentials (MOVIDO PARA .env.local - NÃO COMMITAR)
# Configure em .env.local com valores seguros

# Base URL for E2E tests
BASE_URL="http://localhost:8080"
