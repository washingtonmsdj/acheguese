{
  "name": "achegue-se",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:maps": "eslint src/core/maps src/integrations/maps --ext .ts,.tsx --config eslint.config.js",
    "lint:maps:fix": "eslint src/core/maps src/integrations/maps --ext .ts,.tsx --fix --config eslint.config.js",
    "validate:maps": "node scripts/validate-maps-architecture.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "security:validate": "node scripts/security/validate-security.mjs",
    "security:migrate": "node scripts/migrate-scripts-to-env.mjs",
    "validate:deps": "tsx scripts/validate-dependencies.ts",
    "validate:ssot": "tsx scripts/validate-ssot-compliance.ts",
    "audit:ssot-violations": "tsx scripts/validate-ssot-compliance.ts",
    "report:ssot-compliance": "tsx scripts/validate-ssot-compliance.ts",
    "audit:architecture": "tsx scripts/generate-architecture-audit.ts",
    "check:ssot": "tsx scripts/check-ssot-compliance.ts",
    "plan:ssot-fix": "tsx scripts/generate-ssot-fix-plan.ts",
    "validate:session-context": "tsx scripts/validate-session-context.ts",
    "validate:architecture:delivery": "tsx scripts/validate-delivery-architecture-boundaries.ts",
    "validate:architecture:governance": "tsx scripts/validate-architecture-governance.ts",
    "validate:docs-structure": "tsx scripts/validate-docs-structure.ts",
    "validate:migrations": "tsx scripts/validate-supabase-migrations.ts",
    "validate:hardcodes": "tsx scripts/validate-ssot-hardcodes.ts",
    "generate:migration": "tsx scripts/generate-migration-template.ts",
    "generate:service": "tsx scripts/generate-service-template.ts",
    "lint:ssot": "eslint . --config eslint.config.js",
    "generate:types": "bash scripts/generate-supabase-types.sh",
    "prepare": "husky",
    "verify:deploy": "node scripts/verify-deploy-ready.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ssot": "vitest --run tests/ssot-*.test.ts",
    "test:e2e": "playwright test tests/e2e/tourist-points.spec.ts",
    "test:e2e:ui": "playwright test tests/e2e/tourist-points.spec.ts --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:network": "playwright test e2e/network-branches.spec.ts --reporter=list",
    "test:regression": "vitest --run tests/regression-*.test.ts",
    "test:all": "npm run test:ssot && npm run test:e2e && npm run test:regression",
    "test:maps": "vitest --run src/core/maps",
    "test:maps:watch": "vitest src/core/maps",
    "geocode-locations": "tsx scripts/geocode-locations.ts",
    "seed:e2e": "tsx scripts/seed-e2e-users.ts",
    "seed:e2e:reset": "tsx scripts/seed-e2e-users.ts --reset",
    "seed:e2e:verbose": "tsx scripts/seed-e2e-users.ts --verbose",
    "seed:e2e:network": "tsx scripts/seed-e2e-network.ts",
    "seed:e2e:network:reset": "tsx scripts/seed-e2e-network.ts --reset",
    "validate:e2e": "tsx scripts/validate-e2e-setup.ts",
    "apply:gate2": "tsx scripts/apply-gate2-migration-final.ts",
    "apply:gate2:remote": "tsx scripts/apply-gate2-postgres.ts",
    "apply:gate2:direct": "tsx scripts/apply-gate2-direct-sql.ts"
  },
