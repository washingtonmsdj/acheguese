# Check for secrets before commit
echo "🔒 Checking for secrets..."

# Check if gitleaks is installed
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --config .gitleaks.toml --redact --verbose
    if [ $? -ne 0 ]; then
        echo "❌ Secrets detected! Commit blocked."
        echo "   Remove secrets from staged files or add to allowlist in .gitleaks.toml"
        exit 1
    fi
    echo "✅ No secrets detected"
else
    echo "⚠️  gitleaks not installed - skipping secret detection"
    echo "   Install: https://github.com/gitleaks/gitleaks#installing"
fi

# Check SSOT compliance
sh .husky/check-ssot

# Deterministic quality gates: both commands are repository dependencies.
echo "🔍 Running TypeScript and ESLint gates..."
npm run typecheck:app
npm run lint
