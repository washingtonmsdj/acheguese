# Template de producao. Nao commitar valores reais neste arquivo.
# Configure os valores reais no provedor de deploy e no Supabase secrets.

# Obrigatorio para o build/runtime do frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Dominio publico canonico.
VITE_SITE_NAME=Achegue-se
VITE_SITE_TAGLINE=Super App de Bairro
VITE_PUBLIC_SITE_URL=https://acheguese.com.br
VITE_TWITTER_SITE=@acheguese

# Observabilidade.
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ordax
SENTRY_PROJECT=ordax-saas

# Feature flags publicas.
VITE_FEATURE_COMMUNITY_ALERTS=true
VITE_FEATURE_MAPS_V4=true

# Edge functions e pagamentos. Configure apenas no ambiente seguro.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_DELIVERY=
ALLOWED_ORIGINS=https://acheguese.com.br,https://www.acheguese.com.br
ALLOWED_REDIRECT_DOMAINS=acheguese.com.br,www.acheguese.com.br
VITE_ALLOWED_BILLING_REDIRECT_ORIGINS=https://acheguese.com.br,https://checkout.stripe.com,https://billing.stripe.com
VITE_ALLOWED_QR_REDIRECT_ORIGINS=https://acheguese.com.br

# Territorio comunitario principal da home.
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
