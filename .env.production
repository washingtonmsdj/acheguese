# Arquivo de template para variáveis de ambiente de produção
# Configure estas variáveis no painel da Vercel em: Settings > Environment Variables

# ⚠️ NÃO COMMITE VALORES REAIS NESTE ARQUIVO!
# Este arquivo serve apenas como referência das variáveis necessárias

# Supabase Configuration (OBRIGATÓRIO)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Public branding/domain SSOT
VITE_SITE_NAME=Achegue-se
VITE_SITE_TAGLINE=Super App de Bairro
VITE_PUBLIC_SITE_URL=https://acheguese.com.br
VITE_TWITTER_SITE=@acheguese

# Sentry Configuration (OPCIONAL - para monitoramento de erros)
# VITE_SENTRY_DSN=your_sentry_dsn

# Feature Flags
# VITE_FEATURE_COMMUNITY_ALERTS=true
# VITE_FEATURE_MAPS_V4=true

# Google Maps API (OPCIONAL - se usar mapas do Google)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Stripe Configuration (OPCIONAL - se usar pagamentos)
# STRIPE_SECRET_KEY=sk_live_your_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
# STRIPE_PRICE_ID_PRO=price_your_pro_plan_id
# STRIPE_PRICE_ID_DELIVERY=price_your_delivery_plan_id
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# VITE_ALLOWED_BILLING_REDIRECT_ORIGINS=https://checkout.stripe.com,https://billing.stripe.com

# Redirects de QR Code (adicione origens externas somente quando houver regra de negocio)
# VITE_ALLOWED_QR_REDIRECT_ORIGINS=https://yourdomain.com

# Territorio comunitario principal da home
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
