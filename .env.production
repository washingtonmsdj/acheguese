# Production environment template.
# Do not commit real values. Configure secrets in the deploy provider and in
# Supabase Edge Function secrets.

# Public Supabase config used by the browser.
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Supabase Edge Function runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Public app identity and canonical origin.
VITE_SITE_NAME=Achegue-se
VITE_SITE_TAGLINE=Super App de Bairro
VITE_PUBLIC_SITE_URL=https://your-public-domain.example
VITE_TWITTER_SITE=@acheguese

# Observability.
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=acheguese
SENTRY_PROJECT=acheguese-web

# Public feature flags.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_FEATURE_COMMUNITY_ALERTS=true
VITE_FEATURE_COMMUNITY_ISSUES=false
VITE_FEATURE_COMMUNITY_LEADERBOARD=false
VITE_FEATURE_MAPS_V4=true
VITE_ENABLE_LOCATION_BOUNDARIES=false

# Public legal/contact configuration.
VITE_CONTACT_EMAIL=
VITE_DPO_EMAIL=
VITE_LEGAL_FORUM=

# Edge Function security.
BASE_URL=https://your-public-domain.example
ALLOWED_ORIGINS=https://your-public-domain.example
ALLOWED_REDIRECT_DOMAINS=your-public-domain.example
DENO_ENV=production
CRON_SECRET=
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
CACHE_DEBUG=false

# Frontend redirect allowlists.
VITE_ALLOWED_QR_REDIRECT_ORIGINS=https://your-public-domain.example
VITE_ALLOWED_BILLING_REDIRECT_ORIGINS=https://checkout.stripe.com,https://billing.stripe.com

# Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email.
RESEND_API_KEY=
FROM_EMAIL=
EMAIL_FROM_DOMAIN=
EMAIL_FROM_NAME=Achegue-se

# Push notifications.
VAPID_PUBLIC_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# AI and image generation.
VITE_FEATURE_AI_VIRTUAL_TRYON=false
LOVABLE_API_KEY=
REPLICATE_API_TOKEN=
TRYON_REPLICATE_MODEL_VERSION=
TRYON_REPLICATE_HUMAN_IMAGE_URL=
TRYON_REPLICATE_HUMAN_IMAGE_MALE_URL=
TRYON_REPLICATE_HUMAN_IMAGE_FEMALE_URL=
TRYON_REPLICATE_HUMAN_IMAGE_NEUTRAL_URL=

# External services.
VITE_GOOGLE_MAPS_API_KEY=
VITE_ADSENSE_CLIENT_ID=
IBGE_DISTRICTS_URL=https://servicodados.ibge.gov.br/api/v1/localidades/distritos?view=nivelado
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=
NOMINATIM_ACCEPT_LANGUAGE=pt-BR,pt;q=0.9
NOMINATIM_DEFAULT_COUNTRY=br
NOMINATIM_DEFAULT_COUNTRY_CODES=br
NOMINATIM_DEFAULT_COUNTRY_NAME=Brasil
NOMINATIM_DEFAULT_FORMAT=json
NOMINATIM_DEFAULT_ADDRESSDETAILS=1
NOMINATIM_DEFAULT_LIMIT=3
NOMINATIM_REQUEST_DELAY_MS=1000

# Launch territory.
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
