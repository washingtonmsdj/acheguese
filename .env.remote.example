# Configuração Supabase Remoto - EXEMPLO
# Copie este arquivo para .env.remote e preencha com suas credenciais

# Project URL
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ANON/PUBLIC KEY (obtenha no dashboard: Settings > API > Project API keys)
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_key_here"
VITE_SENTRY_DSN=""
VITE_AUTH_GOOGLE_ENABLED="false"

# SERVICE ROLE KEY (obtenha no dashboard: Settings > API > Project API keys)
# ⚠️ NÃO compartilhe esta chave! É para operações administrativas server-side
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Database URL (obtenha no dashboard: Settings > Database > Connection string)
# Use Session mode (porta 6543) para melhor compatibilidade
SUPABASE_DB_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Explicit opt-in for the private INEP Education staging CLI. Keep false by default.
PUBLIC_EDUCATION_INEP_IMPORT_APPROVED="false"

# Project ID
SUPABASE_PROJECT_ID="your_project_ref"
