# ⚠️ ESTE ARQUIVO É UM TEMPLATE - COPIE PARA .env.local E PREENCHA COM VALORES REAIS
# .env.local NÃO DEVE SER COMMITADO (já está no .gitignore)

# ══════════════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════

# URL do projeto Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Chave pública (publishable key) - segura para uso no frontend
# Novo formato: [supabase publishable key] (substitui a anon key JWT antiga)
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key_here"
VITE_SENTRY_DSN=""
VITE_AUTH_GOOGLE_ENABLED="false"

# Public branding/domain SSOT
VITE_SITE_NAME="Achegue-se"
VITE_SITE_TAGLINE="Super App de Bairro"
VITE_PUBLIC_SITE_URL="http://localhost:8080"
VITE_TWITTER_SITE="@acheguese"

# ⚠️ CRÍTICO: Service role - NUNCA expor no frontend
# SUPABASE_SERVICE_ROLE_KEY deve ser carregada no shell administrativo,
# no secret manager do backend ou nas variaveis protegidas da plataforma.
# Nao persista valores reais em .env.local.

# ══════════════════════════════════════════════════════════════════════════
# SECURITY CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════

# Origens permitidas para CORS (separe múltiplas com vírgula)
# Desenvolvimento: http://localhost:8080,http://localhost:5173
# Produção: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173"

# Redirect allowlists (frontend)
VITE_ALLOWED_QR_REDIRECT_ORIGINS="http://localhost:8080,http://localhost:5173"
VITE_ALLOWED_BILLING_REDIRECT_ORIGINS="https://checkout.stripe.com,https://billing.stripe.com"

# Ambiente (development, staging, production)
DENO_ENV="development"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# ══════════════════════════════════════════════════════════════════════════
# STRIPE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════

# Chave secreta do Stripe (use test key em desenvolvimento)
STRIPE_SECRET_KEY="[stripe secret key]"

# Webhook secret do Stripe
STRIPE_WEBHOOK_SECRET="[stripe webhook secret]"

# ══════════════════════════════════════════════════════════════════════════
# E2E TEST CREDENTIALS
# ══════════════════════════════════════════════════════════════════════════

# ⚠️ Use senhas fortes e únicas para testes
# NUNCA use as mesmas credenciais em produção

E2E_USER_EMAIL="e2e-user@test.local"
E2E_USER_PASSWORD="[GERE_SENHA_FORTE_AQUI]"

E2E_ADMIN_EMAIL="e2e-admin@test.local"
E2E_ADMIN_PASSWORD="[GERE_SENHA_FORTE_AQUI]"

TEST_DRIVER_EMAIL="test-driver@test.local"
TEST_DRIVER_PASSWORD="[GERE_SENHA_FORTE_AQUI]"

# ══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ══════════════════════════════════════════════════════════════════════════

VITE_FEATURE_COMMUNITY_ALERTS="false"
VITE_FEATURE_MAPS_V4="true"

# ══════════════════════════════════════════════════════════════════════════
# EXTERNAL SERVICES
# ══════════════════════════════════════════════════════════════════════════

# Google Maps API Key (opcional)
# VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Resend API Key (para envio de emails)
# RESEND_API_KEY="re_your_resend_api_key"

# ══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════

BASE_URL="http://localhost:8080"

# ══════════════════════════════════════════════════════════════════════════
# COMO GERAR SENHAS FORTES
# ══════════════════════════════════════════════════════════════════════════

# PowerShell:
# -Add-Type -AssemblyName System.Web
# [System.Web.Security.Membership]::GeneratePassword(20, 5)

# Linux/Mac:
# openssl rand -base64 20

# Node.js:
# node -e "console.log(require('crypto').randomBytes(20).toString('base64'))"

# Territorio comunitario principal da home
VITE_LAUNCH_COUNTRY=br
VITE_LAUNCH_STATE=ba
VITE_LAUNCH_CITY=salvador
VITE_LAUNCH_CITY_NAME=Salvador
VITE_LAUNCH_COMMUNITY_SLUG=complexo-do-nordeste-de-amaralina
VITE_LAUNCH_COMMUNITY_NAME=Complexo do Nordeste de Amaralina
VITE_DEFAULT_MAP_LATITUDE=-12.9714
VITE_DEFAULT_MAP_LONGITUDE=-38.5014
VITE_DEFAULT_MAP_CITY=Salvador
VITE_DEFAULT_MAP_REGION=BA
